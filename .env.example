# Copy to .env (never commit .env). Every value below has a safe local default.
ENVIRONMENT=development
BRAND_NAME=IntervueAI
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8100

# Database (docker compose -f infra/docker/docker-compose.yml up -d db)
DATABASE_URL=postgresql+psycopg://intervue:intervue_local_dev@localhost:54329/intervue

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
SESSION_TTL_HOURS=72
# Optional Google OAuth (button only appears when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI provider: mock (deterministic, no key) | gemini (free tier key from aistudio.google.com) | anthropic | openai
#   | openai_compat (any OpenAI-compatible Chat Completions API: Groq, OpenRouter, Ollama; set AI_BASE_URL)
# Free setup: AI_PROVIDER=gemini, AI_MODEL=gemini-3.5-flash, AI_FAST_MODEL=gemini-3.5-flash-lite, AI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.8-flash
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=claude-opus-5-5
AI_FALLBACK_MODEL=
# Optional faster model for live turns (follow-ups, personalisation, code review)
AI_FAST_MODEL=
AI_TIMEOUT_SECONDS=60

# Voice provider: browser (Web Speech API, free) | edge (free neural voice, no key) | elevenlabs (server TTS) | mock
# edge: VOICE_ID is an Edge voice such as en-IN-NeerjaNeural or en-IN-PrabhatNeural (sets STT language too)
VOICE_PROVIDER=browser
VOICE_API_KEY=
VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Screen snapshot analysis: mock | ai (uses AI_PROVIDER vision)
SCREEN_ANALYSIS_PROVIDER=mock

# Object storage: local | s3
STORAGE_BACKEND=local
STORAGE_URL=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=ap-south-1
# AWS credentials come from the standard AWS chain (env/profile/role), never from this file in production.

# Vector DB: embeddings are stored in Postgres (JSON) by default; set when moving to pgvector/managed store.
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# Code execution worker
WORKER_URL=http://localhost:8101
WORKER_TOKEN=change-me-worker-token
EXECUTION_BACKEND=docker
EXECUTION_ALLOW_LOCAL=false

# Cost model
PRICING_CONFIG_PATH=
USD_INR_RATE=83.0
DATA_RETENTION_DAYS=365

DEMO_ENABLED=true
DEMO_DURATION_MINUTES=8

# Web
NEXT_PUBLIC_BRAND_NAME=IntervueAI
API_INTERNAL_URL=http://localhost:8100
