{
  "name": "intervueai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/types",
    "packages/config"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "lint:web": "npm run lint -w web",
    "typecheck:web": "npm run typecheck -w web",
    "test:web": "npm run test -w web",
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "test:api": ".venv/Scripts/python -m pytest -q || .venv/bin/python -m pytest -q",
    "test:e2e": "npm run test:e2e -w web",
    "lint:py": "ruff check . && ruff format --check .",
    "seed": "cd apps/api && python -m app.seed"
  }
}
